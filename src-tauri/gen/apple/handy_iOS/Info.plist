	<string>Wispr Bro turns your speech into text on this iPhone. Audio never leaves it.</string>
	<key>LSRequiresCarbon</key>
	<false/>
	<key>CFBundleDisplayName</key>
	<string>Wispr Bro</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Wispr Bro uses your local network to find your Mac and sync your dictionary, snippets, settings and stats with it. Nothing is sent to a server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_wisprbro-sync._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "ios",
  "description": "Wispr Bro for iPhone: the Hub's plugin permissions. Fork commands (fork_*, ios_*) are app commands and need no permission.",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "process:default",
    "dialog:default",
    "fs:read-files",
    "fs:allow-resource-read-recursive",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**/*" }]
    }
  ]
}

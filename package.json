{
  "name": "handy-app",
  "private": true,
  "version": "1.0.0-alpha.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:keyboard": "bun src/lib/utils/keyboard.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "sync:catalog": "bun scripts/sync-catalog.ts",
    "check:catalog": "bun scripts/sync-catalog.ts --check",
    "build:cjk-font": "bun scripts/build-cjk-font.ts",
    "check:cjk-font": "bun scripts/build-cjk-font.ts --check",
    "postinstall": "bun scripts/check-nix-deps.ts",
    "//fork": "Wispr Bro fork scripts (wb:*) from here to the end of this block; see docs/fork/ARCHITECTURE.md",
    "wb:dev": "ci/llama-server/build.sh --if-missing && tauri dev --config src-tauri/tauri.fork.conf.json",
    "wb:build": "ci/llama-server/build.sh --if-missing && tauri build --config src-tauri/tauri.fork.conf.json",
    "wb:dev:publik": "ci/llama-server/build.sh --if-missing && VITE_WB_EDITION=publik tauri dev --config src-tauri/tauri.fork.conf.json --config src-tauri/tauri.publik.conf.json",
    "wb:build:publik": "ci/llama-server/build.sh --if-missing && VITE_WB_EDITION=publik tauri build --config src-tauri/tauri.fork.conf.json --config src-tauri/tauri.publik.conf.json",
    "wb:llama-server": "ci/llama-server/build.sh",
    "wb:translate": "bun scripts/wb-translate-missing.ts",
    "wb:check:translations": "bun scripts/wb-translate-missing.ts --check && bun scripts/wb-brand-overrides.ts --check",
    "wb:check:translations:strict": "bun scripts/wb-translate-missing.ts --strict-switch",
    "wb:brand": "bun scripts/wb-brand-overrides.ts",
    "wb:icons": "bun scripts/wb-icons.ts",
    "wb:fonts": "bun scripts/wb-fonts.ts",
    "wb:copy-check": "bun scripts/wb-copy-check.ts",
    "wb:test:scripts": "bun test scripts/",
    "//fork:guards": "Wispr Bro CI guards (F-03, R5 §4.12): begin",
    "wb:guards": "bun scripts/wb-guards.ts",
    "wb:guard:identity": "bun scripts/wb-guard-identity.ts",
    "wb:guard:plumbing": "bun scripts/wb-guard-plumbing.ts",
    "wb:guard:hooks": "bun scripts/wb-guard-hooks.ts",
    "wb:guard:hosts": "bun scripts/wb-guard-hosts.ts",
    "wb:guard:bundle-hosts": "bun scripts/wb-guard-bundle-hosts.ts",
    "wb:guard:telemetry": "bun scripts/wb-guard-telemetry.ts",
    "wb:guard:spdx": "bun scripts/wb-guard-spdx.ts",
    "wb:guard:tokens": "bun scripts/wb-guard-tokens.ts",
    "wb:guard:edition": "bun scripts/wb-guard-edition.ts",
    "wb:test:guards": "bun test scripts/wb-guards.test.ts",
    "wb:clippy": "bun scripts/wb-clippy-fork.ts",
    "wb:format:check": "prettier --check --ignore-path .prettierignore --ignore-path .wb-prettierignore . && cd src-tauri && cargo fmt -- --check",
    "//fork:guards-end": "Wispr Bro CI guards: end",
    "wb:test:ui": "playwright test -c playwright.fork.config.ts",
    "wb:sync:dryrun": "bun scripts/wb-upstream-sync.ts",
    "wb:eval:cleanup": "bun scripts/wb-eval-cleanup.ts"
  },
  "dependencies": {
    "@handy-computer/models": "0.2.3",
    "@number-flow/react": "0.6.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6",
    "@tauri-apps/plugin-fs": "~2.4.4",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "canvas-confetti": "1.9.4",
    "driver.js": "1.10.2",
    "html-to-image": "1.11.13",
    "i18next": "^25.7.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.542.0",
    "motion": "14.2.0",
    "papaparse": "5.7.0",
    "react": "^18.3.1",
    "react-activity-calendar": "3.2.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.4.1",
    "react-markdown": "^10.1.0",
    "react-select": "^5.8.0",
    "recharts": "3.10.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.16",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^24.9.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "prettier": "^3.6.2",
    "subset-font": "2.3.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.1"
  }
}

<!-- cargo-about template for the Wispr Bro Rust licence report (F-03). -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Wispr Bro: Rust third-party licences</title>
  </head>
  <body>
    <h1>Rust third-party licences</h1>
    <h2>Overview</h2>
    <ul>
      {{#each overview}}
        <li>{{name}} ({{count}})</li>
      {{/each}}
    </ul>
    <h2>Licences</h2>
    {{#each licenses}}
      <h3 id="{{id}}">{{name}}</h3>
      <p>Used by:</p>
      <ul>
        {{#each used_by}}
          <li>{{crate.name}} {{crate.version}}</li>
        {{/each}}
      </ul>
      <pre>{{text}}</pre>
    {{/each}}
  </body>
</html>